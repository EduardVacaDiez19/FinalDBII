# Configuración del Servidor
PORT=3000
NODE_ENV=development

# SQL Server Configuration
SQL_SERVER=localhost
# Windows Authentication indicator (. = Windows Auth, real user for SQL Auth)
SQL_USER=.
SQL_PASSWORD=

# Docker SQL Server Credentials (usado cuando SQL_USER=.)
