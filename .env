SQL_PASSWORD_DOCKER=YourStrong!Passw0rd
SQL_PORT=1433

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/ClinicaDentalNoSQL

# Seguridad
JWT_SECRET=clinica_dental_secret_key_2024
